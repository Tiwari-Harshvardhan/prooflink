# PROOFLINK Backend Configuration
# Copy this file to .env and adjust values for your environment

# Database Configuration
# For SQLite (default, development):
DATABASE_URL=sqlite:///./prooflink.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/prooflink_db

# Environment
ENVIRONMENT=development

# CORS Origins (comma-separated or use * for all)
CORS_ORIGINS=["*"]

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=PROOFLINK API
VERSION=1.0.0

# Trusted frontend domain used in SMS links (never accept caller-provided redirects)
FRONTEND_URL=http://localhost:5173

# Provider settings. Mock is used for local demo and logs SMS content to the backend console.
SMS_PROVIDER=mock
KYC_PROVIDER=mock

# Set SMS_PROVIDER=twilio only after adding these values locally. Never commit them.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
